{
  "name": "@kushagradhawan/kookie-flow",
  "version": "0.2.0",
  "description": "WebGL-native node graph library. React Flow's ergonomics, GPU-rendered for performance at scale.",
  "author": "Kushagra Dhawan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/KushagraDhawan1997/kookie-flow",
    "directory": "packages/kookie-flow"
  },
  "keywords": [
    "react",
    "node-graph",
    "webgl",
    "three.js",
    "react-three-fiber",
    "node-editor",
    "workflow",
    "diagram"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "kookie-flow-source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./plugins": {
      "kookie-flow-source": "./src/plugins/index.ts",
      "import": {
        "types": "./dist/plugins/index.d.ts",
        "default": "./dist/plugins/index.js"
      },
      "require": {
        "types": "./dist/plugins/index.d.cts",
        "default": "./dist/plugins/index.cjs"
      }
    },
    "./layout": {
      "kookie-flow-source": "./src/core/layout.ts",
      "import": {
        "types": "./dist/core/layout.d.ts",
        "default": "./dist/core/layout.js"
      },
      "require": {
        "types": "./dist/core/layout.d.cts",
        "default": "./dist/core/layout.cjs"
      }
    }
  },
  "files": [
    "dist",
    "PRODUCTION.md"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "lint": "pnpm --filter @kushagradhawan/kookie-flow-core lint && pnpm --filter @kushagradhawan/kookie-flow-webgl lint && pnpm --filter @kushagradhawan/kookie-flow-react lint && tsc --noEmit && tsc -p tsconfig.harness.json",
    "test": "pnpm --filter @kushagradhawan/kookie-flow-core test && pnpm --filter @kushagradhawan/kookie-flow-webgl test && pnpm --filter @kushagradhawan/kookie-flow-react test",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo",
    "generate:fonts": "pnpm --filter @kushagradhawan/kookie-flow-webgl generate:fonts",
    "harness:build": "node harness/build.mjs",
    "harness:spike:color": "node harness/spikes/color-parity.mjs",
    "harness:spike:labels": "node harness/spikes/label-zoom.mjs",
    "harness:behaviors": "node harness/behaviors.mjs",
    "harness:spike:formats": "node harness/spikes/color-formats.mjs",
    "harness:perf": "node harness/spikes/perf-baseline.mjs",
    "harness:cull": "node harness/spikes/cull-bench.mjs",
    "harness:spike:theme": "node harness/spikes/theme-flip.mjs",
    "harness:spike:glass": "node harness/spikes/glass-look.mjs",
    "harness:spike:compare": "node harness/spikes/glass-compare.mjs",
    "harness:spike:magnet": "node harness/spikes/magnet.mjs",
    "harness:counts": "node harness/spikes/counts.mjs",
    "harness:tokens": "node harness/spikes/token-census.mjs",
    "test:browser": "node harness/build.mjs && node harness/behaviors.mjs",
    "harness:store": "node harness/spikes/core-store-bench.mjs",
    "harness:evaluation": "node harness/spikes/evaluation-bench.mjs",
    "test:spatial-stress": "node harness/spikes/spatial-overlap.mjs",
    "test:package": "node ../../scripts/test-packages.mjs",
    "check:release": "pnpm -w check:boundaries && pnpm run lint && pnpm run test && pnpm run test:spatial-stress && pnpm --filter @kushagradhawan/kookie-flow... run build && pnpm run test:package && pnpm run test:browser"
  },
  "dependencies": {
    "@kushagradhawan/kookie-flow-react": "workspace:*",
    "@kushagradhawan/kookie-flow-core": "workspace:*"
  },
  "peerDependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "~0.186.0",
    "@kushagradhawan/kookie-ui-react": "0.0.0-flow.1"
  },
  "devDependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "msdf-bmfont-xml": "^2.8.0",
    "playwright-core": "^1.63.0",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "three": "^0.186.0",
    "tsup": "^8.3.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "@kushagradhawan/kookie-ui-react": "file:../../vendor/kushagradhawan-kookie-ui-react-0.0.0-flow.1.tgz",
    "vite": "^8.3.0",
    "@kushagradhawan/kookie-flow-webgl": "workspace:*"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
