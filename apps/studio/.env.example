# Copy to `.env.local` (gitignored) and fill in what you have. Every setting is optional: with
# none of them the studio runs on an embedded database, local files and a mock provider.

# fal.ai → dashboard → Keys. With a key set, generation nodes run on fal for real and cost
# money; set a spending cap on the key at fal first. Empty, the mock answers every job for free.
FAL_KEY=

# Which provider answers jobs: `fal` or `mock`. Unset, it is fal when FAL_KEY is set and the
# mock otherwise. `mock` here keeps the mock even with a key, for working on the editor.
# STUDIO_PROVIDER=mock

# How long a mock job pretends to take, in milliseconds. Default 2000.
# STUDIO_MOCK_DELAY_MS=2000

# Later phases. Leave unset until they land.
# ANTHROPIC_API_KEY=
# DATABASE_URL=
# STUDIO_DATA_DIR=
